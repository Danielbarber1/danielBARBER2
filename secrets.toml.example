# העתק לקובץ secrets.toml (מקומי) או הדבק ב-Secrets של Streamlit Cloud.
# אל תעלה secrets.toml ל-GitHub.

GEMINI_API_KEY = "AIza..."
TAVILY_API_KEY = "tvly-..."          # אופציונלי
ADMIN_EMAIL = "you@gmail.com"        # רק החשבון הזה יכול להיכנס

[auth]
# בענן: https://your-app.streamlit.app/oauth2callback
# מקומי: http://localhost:8501/oauth2callback
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "החלף במחרוזת אקראית ארוכה"

[auth.google]
client_id = "xxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-..."
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
